{
  "name": "Present Simple",
  "nameAr": "المضارع البسيط",

  "explanation": "نستخدم المضارع البسيط للتحدث عن العادات والروتين والحقائق والأشياء التي تحدث بشكل متكرر.",

  "uses": [
    "العادات والأشياء التي نفعلها بشكل متكرر.",
    "الروتين اليومي.",
    "الحقائق والمعلومات الثابتة.",
    "الأشياء التي تحدث بشكل منتظم."
  ],

  "structure": {
    "i_you_we_they": "I / You / We / They + الفعل",
    "he_she_it": "He / She / It + الفعل + s / es"
  },

  "verbRules": [
    {
      "rule": "معظم الأفعال",
      "form": "الفعل + s",
      "examples": [
        "play → plays",
        "read → reads",
        "eat → eats",
        "work → works"
      ]
    },
    {
      "rule": "الأفعال التي تنتهي بـ s أو sh أو ch أو x أو o أو z",
      "form": "الفعل + es",
      "examples": [
        "watch → watches",
        "wash → washes",
        "fix → fixes",
        "go → goes",
        "pass → passes"
      ]
    },
    {
      "rule": "إذا انتهى الفعل بـ y وقبلها حرف ساكن",
      "form": "نحذف y ونضيف ies",
      "examples": [
        "study → studies",
        "try → tries",
        "fly → flies"
      ]
    },
    {
      "rule": "إذا انتهى الفعل بـ y وقبلها حرف متحرك",
      "form": "الفعل + s",
      "examples": [
        "play → plays",
        "enjoy → enjoys",
        "buy → buys"
      ]
    }
  ],

